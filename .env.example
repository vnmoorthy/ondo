# Copy to .env and fill in. Never commit .env.
# All keys are used server-side only (FastAPI); the browser only sees REACT_APP_BACKEND_URL.

# You.com API key (Search + Answer). Sent as X-API-Key with User-Agent: Ondo/1.0.
YDC_API_KEY=

# Emergent Universal LLM key (Claude Sonnet 5.5): intake extraction, explanation, translation, staff incidents.
EMERGENT_LLM_KEY=

# MongoDB connection string and database name, e.g. mongodb://localhost:27017 and ondo
MONGO_URL=
DB_NAME=

# Where the React app reaches the FastAPI backend, e.g. http://localhost:8001
REACT_APP_BACKEND_URL=
